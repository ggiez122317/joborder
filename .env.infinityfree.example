# InfinityFree production env. Upload as ".env" next to the app files
# (FileZilla: right-click > Create new file, or upload then rename).
# NEVER commit this file. Generate fresh secrets below.

APP_NAME="LGU TRENTO PDS"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=https://your-domain.epizy.com
APP_KEY=base64:PASTE_KEY_GENERATED_WITH_PHP_ARTISAN_KEY_GENERATE_--SHOW

DB_CONNECTION=mysql
DB_HOST=sqlXXX.epizy.com
DB_PORT=3306
DB_DATABASE=epiz_XXX_pds
DB_USERNAME=epiz_XXX
DB_PASSWORD=PASTE_DATABASE_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Uploads stay on the hosting disk (it is persistent here).
# Leave R2 empty unless you later move uploads off-server.

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# One-time setup token for /setup/<token> (storage link + migrate).
# Visit once after deploy, then delete this line. Use a long random string.
SETUP_TOKEN=PASTE_LONG_RANDOM_STRING_HERE

JWT_SECRET=PASTE_RANDOM_64_CHAR_STRING_HERE
